@model IEnumerable<PROG6212_POE.Models.Claim>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Claims Management - F-Pattern Layout</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .bg-primary {
            background: linear-gradient(135deg, #5E52AD 50%, #A1AD52 50%) !important;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #5E52AD 0%, #A1AD52 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
            margin-bottom: 20px;
        }

        /* F-Pattern: Top Horizontal Bar (Header) */
        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 3px solid #5E52AD;
            margin-bottom: 30px;
            background: linear-gradient(90deg, #5E52AD, #A1AD52);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo {
            font-size: 2rem;
            font-weight: bold;
        }

        .logout-btn {
            padding: 10px 20px;
            background: linear-gradient(45deg, #dc3545, #c82333);
            color: white;
            -webkit-text-fill-color: white;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .logout-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(220, 53, 69, 0.4);
            }

        .nav-actions {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(45deg, #5E52AD, #A1AD52);
            color: white;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
            }

        .btn-secondary {
            background: white;
            color: #5E52AD;
            border: 2px solid #5E52AD;
        }

            .btn-secondary:hover {
                background: #5E52AD;
                color: white;
            }

        /* F-Pattern: Main Content Area */
        .f-layout {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 40px;
            margin-bottom: 30px;
        }

        /* F-Pattern: Left Vertical Scan (Sidebar) */
        .sidebar {
            background: rgba(255, 255, 255, 0.8);
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            height: fit-content;
            position: sticky;
            top: 20px;
        }

            .sidebar h3 {
                color: #5E52AD;
                margin-bottom: 20px;
                font-size: 1.3rem;
            }

        .sidebar-menu {
            list-style: none;
        }

            .sidebar-menu li {
                margin-bottom: 12px;
                padding: 12px;
                border-radius: 8px;
                transition: all 0.3s ease;
                cursor: pointer;
            }

                .sidebar-menu li:hover, .sidebar-menu li.active {
                    background: linear-gradient(45deg, #5E52AD, #A1AD52);
                    color: white;
                    transform: translateX(5px);
                }

        /* F-Pattern: Second Horizontal Emphasis (Content Header) */
        .content-header {
            background: linear-gradient(135deg, #5E52AD, #A1AD52);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }

            .content-header h1 {
                font-size: 2.5rem;
                margin-bottom: 10px;
            }

            .content-header p {
                font-size: 1.1rem;
                opacity: 0.9;
            }

        /* F-Pattern: Main Content Cards */
        .content-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            border-left: 5px solid #5E52AD;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            }

            .card h3 {
                color: #5E52AD;
                margin-bottom: 15px;
                font-size: 1.4rem;
            }

        /* Claims Table */
        .claims-section {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }

        .claims-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

            .claims-table thead {
                background: linear-gradient(135deg, #5E52AD, #A1AD52);
                color: white;
            }

            .claims-table th,
            .claims-table td {
                padding: 15px;
                text-align: left;
                border-bottom: 1px solid #eee;
            }

            .claims-table th {
                font-weight: 600;
                letter-spacing: 0.5px;
            }

            .claims-table tbody tr {
                transition: all 0.3s ease;
            }

                .claims-table tbody tr:hover {
                    background: rgba(102, 126, 234, 0.05);
                    transform: scale(1.01);
                }

                .claims-table tbody tr.hidden {
                    display: none;
                }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-approved {
            background: #d4edda;
            color: #155724;
        }

        .status-rejected {
            background: #f8d7da;
            color: #721c24;
        }

        .user-badge {
            padding: 4px 10px;
            background: linear-gradient(135deg, #5AA587, #A55A78);
            color: white;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        /* Form Section */
        .form-section {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-weight: 600;
                color: #667eea;
            }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: #5E52AD;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

        /* Action Links */
        .action-links {
            display: flex;
            gap: 10px;
        }

            .action-links a {
                color: #5E52AD;
                text-decoration: none;
                padding: 6px 12px;
                border-radius: 6px;
                transition: all 0.3s ease;
                font-size: 0.9rem;
            }

                .action-links a:hover {
                    background: #5E52AD;
                    color: white;
                }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #666;
        }

            .empty-state h3 {
                color: #5E52AD;
                margin-bottom: 15px;
                font-size: 1.5rem;
            }

        /* Responsive Design */
        (max-width: 768px) {
            .f-layout

        {
            grid-template-columns: 1fr;
        }

        .sidebar {
            position: static;
        }

        .content-cards {
            grid-template-columns: 1fr;
        }

        .header-bar {
            flex-direction: column;
            gap: 15px;
        }

        .nav-actions {
            flex-wrap: wrap;
            justify-content: center;
        }

        }

        /* Animations */
        fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .card, .claims-section, .form-section {
            animation: fadeInUp 0.6s ease-out;
        }

            .card:nth-child(1) {
                animation-delay: 0.1s;
            }

            .card:nth-child(2) {
                animation-delay: 0.2s;
            }

            .card:nth-child(3) {
                animation-delay: 0.3s;
            }
    </style>
</head>
<body>
    <div class="container">
        <!-- F-Pattern: Top Horizontal Bar -->
        <header class="header-bar">
            <div class="logo">Contract Management Claim System</div>
            <div>
                <span style="margin-right: 15px; color: #5AA587; font-weight: 600;">Welcome, @ViewBag.UserName</span>
                <a asp-controller="Account" asp-action="Logout" class="logout-btn">Logout</a>
            </div>
        </header>

        <div class="f-layout">
            <!-- F-Pattern: Left Vertical Scan -->
            <aside class="sidebar">
                <h3>Navigation</h3>
                <ul class="sidebar-menu">
                    <li class="active" data-filter="all">Your Claims</li>
                    <li data-filter="pending">Pending Review</li>
                    <li data-filter="approved">Approved</li>
                    <li data-filter="rejected">Rejected</li>
                </ul>

                <h3 style="margin-top: 30px;">Quick Stats</h3>
                <div style="padding: 15px; background: rgba(102, 126, 234, 0.1); border-radius: 10px; margin-top: 10px;">
                    <div style="font-size: 1.5rem; font-weight: bold; color: #5E52AD;">@(Model?.Count() ?? 0)</div>
                    <div style="font-size: 0.9rem; color: #666;">Total Claims</div>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div style="padding: 15px; background: rgba(161, 173, 82, 0.1); border-radius: 10px; margin-top: 10px;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #A1AD52;">@Model.Count(c => c.claimStatus?.ToLower() == "pending")</div>
                        <div style="font-size: 0.9rem; color: #666;">Pending</div>
                    </div>

                    <div style="padding: 15px; background: rgba(161, 173, 82, 0.1); border-radius: 10px; margin-top: 10px;">
                        <div style="font-size: 1.5rem; font-weight: bold; color: #155724;">@Model.Count(c => c.claimStatus?.ToLower() == "approved")</div>
                        <div style="font-size: 0.9rem; color: #666;">Approved</div>
                    </div>
                }
            </aside>

            <main>
                <!-- Claims Table Section -->
                <section class="claims-section">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                        <h2 style="color: #5E52AD;" id="section-title">Your Claims</h2>
                        <a href="@Url.Action("Create", "Lecturer")" class="btn btn-primary">Create New Claim</a>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <table class="claims-table">
                            <thead>
                                <tr>
                                    <th>Claim ID</th>
                                    <th>Hourly Rate</th>
                                    <th>Hours Worked</th>
                                    <th>Total Amount</th>
                                    <th>Notes</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model)
                                {
                                    var totalAmount = claim.hourlyRate * claim.hoursWorked;
                                    var statusClass = claim.claimStatus?.ToLower() switch
                                    {
                                        "pending" => "status-pending",
                                        "approved" => "status-approved",
                                        "rejected" => "status-rejected",
                                        _ => "status-pending"
                                    };

                                    <tr data-status="@(claim.claimStatus?.ToLower() ?? "pending")">
                                        <td>CLM-@claim.claimId.ToString("D4")</td>
                                        <td>R @claim.hourlyRate.ToString("N2")</td>
                                        <td>@claim.hoursWorked</td>
                                        <td><strong>R @totalAmount.ToString("N2")</strong></td>
                                        <td>@(string.IsNullOrEmpty(claim.claimNotes) ? "No notes" : claim.claimNotes)</td>
                                        <td><span class="status-badge @statusClass">@(claim.claimStatus ?? "Pending")</span></td>
                                        <td>@claim.dateOfClaim.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <div class="action-links">
                                                <a href="@Url.Action("Read", "Lecturer", new { id = claim.claimId })">Details</a>
                                                <a href="@Url.Action("Delete", "Lecturer", new { id = claim.claimId })">Delete</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="empty-state" id="no-results-message" style="display: none;">
                            <h3>No Claims Found</h3>
                            <p>No claims match the selected filter.</p>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <h3>No Claims Found</h3>
                            <p>You haven't submitted any claims yet. Click "Create New Claim" to get started.</p>
                        </div>
                    }
                </section>
            </main>
        </div>
    </div>

    <script>
        // Filter functionality
        document.querySelectorAll('.sidebar-menu li').forEach(item => {
            item.addEventListener('click', function() {
                // Update active state
                const activeItem = document.querySelector('.sidebar-menu li.active');
                if (activeItem) {
                    activeItem.classList.remove('active');
                }
                this.classList.add('active');

                // Get filter value
                const filter = this.getAttribute('data-filter');

                // Update section title
                const sectionTitle = document.getElementById('section-title');
                if (filter === 'all') {
                    sectionTitle.textContent = 'Your Claims';
                } else {
                    sectionTitle.textContent = filter.charAt(0).toUpperCase() + filter.slice(1) + ' Claims';
                }

                // Filter table rows
                const rows = document.querySelectorAll('.claims-table tbody tr');
                let visibleCount = 0;

                rows.forEach(row => {
                    const status = row.getAttribute('data-status');

                    if (filter === 'all' || status === filter) {
                        row.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        row.classList.add('hidden');
                    }
                });

                // Show/hide "no results" message
                const noResultsMessage = document.getElementById('no-results-message');
                const table = document.querySelector('.claims-table');

                if (visibleCount === 0) {
                    if (table) table.style.display = 'none';
                    if (noResultsMessage) noResultsMessage.style.display = 'block';
                } else {
                    if (table) table.style.display = 'table';
                    if (noResultsMessage) noResultsMessage.style.display = 'none';
                }
            });
        });

        // Table row click effect
        document.querySelectorAll('.claims-table tbody tr').forEach(row => {
            row.addEventListener('click', function(e) {
                if (!e.target.closest('a')) {
                    this.style.background = 'rgba(102, 126, 234, 0.1)';
                    setTimeout(() => {
                        this.style.background = '';
                    }, 200);
                }
            });
        });
    </script>
</body>
</html>