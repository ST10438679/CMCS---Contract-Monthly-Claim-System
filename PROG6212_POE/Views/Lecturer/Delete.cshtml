@model PROG6212_POE.Models.Claim

@{
    ViewData["Title"] = "Delete Claim";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete Claim - Contract Management System</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #5E52AD 0%, #A1AD52 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 3px solid #5E52AD;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 2rem;
            font-weight: bold;
            background: linear-gradient(90deg, #5E52AD, #A1AD52);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .user-info {
            color: #5AA587;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-block;
        }

        .btn-danger {
            background: linear-gradient(45deg, #dc3545, #c82333);
            color: white;
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.4);
        }

            .btn-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(220, 53, 69, 0.6);
            }

        .content-header {
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(220, 53, 69, 0.3);
        }

            .content-header h1 {
                font-size: 2.5rem;
                margin-bottom: 10px;
            }

            .content-header p {
                font-size: 1.1rem;
                opacity: 0.9;
            }

        .warning-alert {
            background: linear-gradient(135deg, #fff3cd, #ffeaa7);
            color: #856404;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
            border-left: 5px solid #ffc107;
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
        }

            .warning-alert h3 {
                margin-bottom: 10px;
                color: #856404;
            }

        .document-warning {
            background: linear-gradient(135deg, #f8d7da, #f5c6cb);
            color: #721c24;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
            border-left: 5px solid #dc3545;
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
        }

            .document-warning h3 {
                margin-bottom: 10px;
                color: #721c24;
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .details-section {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }

        .details-grid {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 20px 40px;
            align-items: center;
        }

        .details-label {
            font-weight: 600;
            color: #5E52AD;
            font-size: 1rem;
        }

        .details-value {
            padding: 10px 15px;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 3px solid #5E52AD;
        }

        .status-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
            text-transform: uppercase;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-approved {
            background: #d4edda;
            color: #155724;
        }

        .status-rejected {
            background: #f8d7da;
            color: #721c24;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }

        .back-link {
            color: #5E52AD;
            text-decoration: none;
            padding: 12px 24px;
            border: 2px solid #5E52AD;
            border-radius: 25px;
            transition: all 0.3s ease;
            font-weight: 600;
        }

            .back-link:hover {
                background: #5E52AD;
                color: white;
            }

        (max-width: 768px) {
            .details-grid

        {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .form-actions {
            flex-direction: column;
        }

        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header-bar">
            <div class="logo">Contract Management Claim System</div>
            <div class="user-info">@ViewBag.UserFullName</div>
        </header>

        <main>
            <div class="content-header">
                <h1>Delete Claim</h1>
                <p>Remove this claim permanently from the system</p>
            </div>

            <div class="warning-alert">
                <h3>⚠️ Are you sure you want to delete this claim?</h3>
                <p>This action will permanently remove the claim and all associated data. This cannot be undone.</p>
            </div>

            @if (Model.document != null && Model.document.Length > 0)
            {
                <div class="document-warning">
                    <h3>
                        <span>📄</span>
                        Associated Documents Will Be Deleted
                    </h3>
                    <p>Deleting this claim will also permanently remove all supporting documents and files. Consider downloading any important documents before proceeding with the deletion.</p>
                </div>
            }

            <section class="details-section">
                <h3 style="color: #5E52AD; margin-bottom: 25px; font-size: 1.5rem;">Claim Details</h3>

                <div class="details-grid">
                    <div class="details-label">Claim ID:</div>
                    <div class="details-value">CLM-@Model.claimId.ToString("D4")</div>

                    <div class="details-label">Lecturer:</div>
                    <div class="details-value">@ViewBag.UserFullName</div>

                    <div class="details-label">Hourly Rate:</div>
                    <div class="details-value">R @Model.hourlyRate.ToString("N2")</div>

                    <div class="details-label">Hours Worked:</div>
                    <div class="details-value">@Model.hoursWorked hours</div>

                    <div class="details-label">Claim Notes:</div>
                    <div class="details-value">@Model.claimNotes</div>

                    <div class="details-label">Claim Status:</div>
                    <div class="details-value">
                        @{
                            var statusClass = Model.claimStatus?.ToLower() switch
                            {
                                "pending" => "status-pending",
                                "approved" => "status-approved",
                                "rejected" => "status-rejected",
                                _ => "status-pending"
                            };
                        }
                        <span class="status-badge @statusClass">@Model.claimStatus</span>
                    </div>

                    <div class="details-label">Date of Claim:</div>
                    <div class="details-value">@Model.dateOfClaim.ToString("MMMM dd, yyyy")</div>

                    @if (Model.document != null && Model.document.Length > 0)
                    {
                        <div class="details-label">Supporting Documents:</div>
                        <div class="details-value">
                            <span>📄 Document attached (@Model.documentName)</span>
                        </div>
                    }

                    <div class="details-label">Total Amount:</div>
                    <div class="details-value" style="font-weight: bold; color: #5E52AD; font-size: 1.1rem;">R @Model.totalAmount.ToString("N2")</div>
                </div>

                <form asp-action="DeleteConfirmed" method="post" onsubmit="return confirmDelete()">
                    <input type="hidden" name="id" value="@Model.claimId" />
                    @Html.AntiForgeryToken()
                    <div class="form-actions">
                        <input type="submit" value="Delete Claim" class="btn btn-danger" />
                        <a asp-action="Index" class="back-link">Back to List</a>
                    </div>
                </form>
            </section>
        </main>
    </div>

    <script>
        function confirmDelete() {
            return confirm(
                'FINAL CONFIRMATION:\n\n' +
                'Are you absolutely sure you want to delete this claim?\n\n' +
                '• Claim CLM-@Model.claimId.ToString("D4") will be permanently removed\n' +
                '• All supporting documents will be deleted\n' +
                '• This action CANNOT be undone\n\n' +
                'Click OK to confirm deletion.'
            );
        }
    </script>
</body>
</html>