@model PROG6212_POE.Models.Claim

@{
    ViewData["Title"] = "Create New Claim";
    var totalAmount = 0.0;
    var userHourlyRate = ViewBag.UserHourlyRate ?? 0;
    var userHourCap = ViewBag.UserHourCap ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Claim - Contract Management System</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .bg-primary {
            background: linear-gradient(135deg, #5E52AD 50%, #A1AD52 50%) !important;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #5E52AD 0%, #A1AD52 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 3px solid #5E52AD;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 2rem;
            font-weight: bold;
            background: linear-gradient(90deg, #5E52AD, #A1AD52);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .user-info {
            color: #5AA587;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(45deg, #5E52AD, #A1AD52);
            color: white;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
            }

        .content-header {
            background: linear-gradient(135deg, #5E52AD, #A1AD52);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }

            .content-header h1 {
                font-size: 2.5rem;
                margin-bottom: 10px;
            }

            .content-header p {
                font-size: 1.1rem;
                opacity: 0.9;
            }

        .details-section {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            animation: fadeInUp 0.6s ease-out;
        }

        .details-grid {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 20px 40px;
            align-items: center;
        }

        .details-label {
            font-weight: 600;
            color: #5E52AD;
            font-size: 1rem;
        }

        .details-value {
            padding: 15px 20px;
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            border-radius: 10px;
            border-left: 4px solid #5E52AD;
            font-size: 1rem;
        }

            .details-value.highlight {
                background: linear-gradient(135deg, #e3f2fd, #bbdefb);
                border-left-color: #2196f3;
                font-weight: 600;
                font-size: 1.2rem;
            }

            .details-value input,
            .details-value textarea,
            .details-value select {
                width: 100%;
                padding: 0;
                border: none;
                background: transparent;
                font-size: 1rem;
                font-family: inherit;
                color: #333;
            }

                .details-value input:focus,
                .details-value textarea:focus,
                .details-value select:focus {
                    outline: none;
                }

            .details-value textarea {
                resize: vertical;
                min-height: 80px;
            }

        .file-upload-wrapper {
            position: relative;
        }

            .file-upload-wrapper input[type="file"] {
                position: absolute;
                opacity: 0;
                width: 100%;
                height: 100%;
                cursor: pointer;
            }

        .file-upload-display {
            background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
            border: 2px dashed #4caf50;
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .file-upload-display:hover {
                background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(76, 175, 80, 0.3);
            }

            .file-upload-display.has-file {
                background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
                border-style: solid;
            }

        .file-icon {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .file-text {
            color: #2e7d32;
            font-weight: 600;
        }

        .file-name {
            color: #388e3c;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .summary-card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            text-align: center;
            transition: all 0.3s ease;
            border-top: 4px solid #5E52AD;
        }

            .summary-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
            }

            .summary-card h4 {
                color: #5E52AD;
                margin-bottom: 10px;
            }

            .summary-card .value {
                font-size: 1.8rem;
                font-weight: bold;
                color: #333;
            }

            .summary-card .subtitle {
                font-size: 0.9rem;
                color: #666;
                margin-top: 5px;
            }

        .action-section {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .back-link {
            color: #5E52AD;
            text-decoration: none;
            padding: 12px 24px;
            border: 2px solid #5E52AD;
            border-radius: 25px;
            transition: all 0.3s ease;
            font-weight: 600;
        }

            .back-link:hover {
                background: #5E52AD;
                color: white;
            }

        .validation-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 5px;
            display: block;
        }

        .status-badge {
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 0.95rem;
            font-weight: 600;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-pending {
            background: linear-gradient(135deg, #fff3cd, #ffeaa7);
            color: #856404;
            border: 2px solid #ffc107;
        }

        .hour-cap-warning {
            background: linear-gradient(135deg, #fff3cd, #ffeaa7);
            color: #856404;
            padding: 15px 20px;
            border-radius: 10px;
            border-left: 4px solid #ffc107;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        (max-width: 768px) {
            .header-bar

        {
            flex-direction: column;
            gap: 15px;
        }

        .details-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .summary-cards {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

        }

        fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .details-section, .summary-cards, .action-section {
            animation: fadeInUp 0.6s ease-out;
        }
    </style>
</head>
<body>
    <div class="container">
        <form asp-action="Create" asp-controller="Lecturer" method="post" enctype="multipart/form-data" id="claimForm">
            <!-- Header -->
            <header class="header-bar">
                <div class="logo">Contract Management Claim System</div>
                <div class="user-info">@ViewBag.UserFullName</div>
            </header>

            <div class="f-layout">
                <main>
                    <!-- Content Header -->
                    <div class="content-header">
                        <h1>Submit Claim</h1>
                        <p>Please enter your hours, your notes and supporting documents for your new claim</p>
                    </div>

                    <!-- Hour Cap Warning -->
                    @if (userHourCap > 0)
                    {
                        <div class="hour-cap-warning">
                            <span style="font-size: 1.5rem;">⚠️</span>
                            <div>
                                <strong>Hour Cap Limit:</strong> You can claim a maximum of <strong>@userHourCap hours</strong> for this claim.
                            </div>
                        </div>
                    }

                    <!-- Summary Cards -->
                    <div class="summary-cards">
                        <div class="summary-card">
                            <h4>Total Amount</h4>
                            <div class="value">R <span id="displayTotal">0.00</span></div>
                        </div>
                        <div class="summary-card">
                            <h4>Hours Worked</h4>
                            <div class="value" id="displayHours">0</div>
                            @if (userHourCap > 0)
                            {
                                <div class="subtitle">Max: @userHourCap hours</div>
                            }
                        </div>
                        <div class="summary-card">
                            <h4>Hourly Rate</h4>
                            <div class="value">R <span id="displayRate">@userHourlyRate.ToString("N2")</span></div>
                            <div class="subtitle">Your Rate</div>
                        </div>
                    </div>

                    <!-- Claim Details Section -->
                    <section class="details-section">
                        <h3 style="color: #5E52AD; margin-bottom: 25px; font-size: 1.5rem;">📋 Claim Information</h3>

                        <div class="details-grid">
                            <div class="details-label">Hourly Rate:</div>
                            <div class="details-value">
                                R <input asp-for="hourlyRate" type="number" step="0.01" min="0" required
                                         value="@userHourlyRate"
                                         oninput="calculateTotal()"
                                         style="display: inline; width: auto;" readonly /> per hour
                                <span asp-validation-for="hourlyRate" class="validation-message"></span>
                            </div>

                            <div class="details-label">Hours Worked:</div>
                            <div class="details-value">
                                <input asp-for="hoursWorked" type="number" step="1" min="0"
                                       max="@userHourCap" required
                                       placeholder="Enter hours worked (Max: @userHourCap)"
                                       oninput="calculateTotal()" />
                                <span asp-validation-for="hoursWorked" class="validation-message"></span>
                            </div>

                            <div class="details-label">Claim Notes:</div>
                            <div class="details-value">
                                <textarea asp-for="claimNotes" required
                                          placeholder="Provide detailed notes about the work completed..."></textarea>
                                <span asp-validation-for="claimNotes" class="validation-message"></span>
                            </div>

                            <div class="details-label">Current Status:</div>
                            <div class="details-value">
                                <span class="status-badge status-pending">PENDING</span>
                            </div>

                            <div class="details-label">Date Submitted:</div>
                            <div class="details-value">
                                <input asp-for="dateOfClaim" type="date" required readonly />
                                <span asp-validation-for="dateOfClaim" class="validation-message"></span>
                            </div>

                            <div class="details-label">Supporting Documents:</div>
                            <div class="details-value">
                                <div class="file-upload-wrapper">
                                    <input type="file" name="documentFile" id="documentUpload"
                                           accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                                           onchange="updateFileDisplay(this)" />
                                    <div class="file-upload-display" id="fileDisplay">
                                        <div class="file-icon">📄</div>
                                        <div class="file-text">Click to upload supporting documents</div>
                                        <div class="file-name" id="fileNameDisplay" style="display: none;"></div>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" asp-for="document" id="documentHidden" />

                            <div class="details-label">Total Claim Value:</div>
                            <div class="details-value highlight">R <span id="totalAmount">0.00</span></div>
                        </div>
                    </section>

                    <input type="hidden" asp-for="claimStatus" value="Pending" />
                    <input type="hidden" asp-for="claimId" value="0" />

                    <!-- Action Buttons Section -->
                    <section class="action-section">
                        <h3 style="color: #5E52AD; margin-bottom: 20px;">Available Actions</h3>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">
                                ✅ Submit Claim
                            </button>
                            <a href="@Url.Action("Index", "Lecturer")" class="back-link">Back to List</a>
                        </div>
                    </section>
                </main>
            </div>
        </form>
    </div>

    <script>
        const userHourCap = @userHourCap;

        // Calculate total amount and update all displays
        function calculateTotal() {
            const hourlyRateInput = document.querySelector('input[name="hourlyRate"]');
            const hoursWorkedInput = document.querySelector('input[name="hoursWorked"]');

            const hourlyRate = parseFloat(hourlyRateInput.value) || 0;
            const hoursWorked = parseFloat(hoursWorkedInput.value) || 0;

            // Check hour cap validation
            if (userHourCap > 0 && hoursWorked > userHourCap) {
                hoursWorkedInput.setCustomValidity(`Hours cannot exceed ${userHourCap}`);
                hoursWorkedInput.style.borderColor = '#dc3545';
            } else {
                hoursWorkedInput.setCustomValidity('');
                hoursWorkedInput.style.borderColor = '';
            }

            const total = hourlyRate * hoursWorked;

            // Update all displays
            document.getElementById('totalAmount').textContent = total.toFixed(2);
            document.getElementById('displayTotal').textContent = total.toFixed(2);
            document.getElementById('displayHours').textContent = hoursWorked;
            document.getElementById('displayRate').textContent = hourlyRate.toFixed(2);
        }

        // Update file display
        function updateFileDisplay(input) {
            const fileDisplay = document.getElementById('fileDisplay');
            const fileNameDisplay = document.getElementById('fileNameDisplay');

            if (input.files && input.files[0]) {
                fileDisplay.classList.add('has-file');
                fileNameDisplay.textContent = '📎 ' + input.files[0].name;
                fileNameDisplay.style.display = 'block';
                fileDisplay.querySelector('.file-text').textContent = 'Document attached';
            } else {
                fileDisplay.classList.remove('has-file');
                fileNameDisplay.style.display = 'none';
                fileDisplay.querySelector('.file-text').textContent = 'Click to upload supporting documents';
            }
        }

        // Set default date to today and hourly rate
        document.addEventListener('DOMContentLoaded', function() {
            const dateInput = document.querySelector('input[name="dateOfClaim"]');
            if (dateInput && !dateInput.value) {
                const today = new Date().toISOString().split('T')[0];
                dateInput.value = today;
            }

            // Initialize calculation
            calculateTotal();

            // Add hover effects to summary cards
            document.querySelectorAll('.summary-card').forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.borderTopColor = '#A1AD52';
                });

                card.addEventListener('mouseleave', function() {
                    this.style.borderTopColor = '#5E52AD';
                });
            });
        });

        // Form validation
        document.getElementById('claimForm').addEventListener('submit', function(e) {
            const hourlyRate = parseFloat(document.querySelector('input[name="hourlyRate"]').value);
            const hoursWorked = parseFloat(document.querySelector('input[name="hoursWorked"]').value);

            if (hourlyRate <= 0 || hoursWorked <= 0) {
                e.preventDefault();
                alert('Please ensure hourly rate and hours worked are greater than 0.');
                return false;
            }

            if (userHourCap > 0 && hoursWorked > userHourCap) {
                e.preventDefault();
                alert(`Hours worked cannot exceed your hour cap of ${userHourCap} hours.`);
                return false;
            }
        });
    </script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>