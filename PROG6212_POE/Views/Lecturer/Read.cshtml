@model PROG6212_POE.Models.Claim

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Claim Details - Contract Management System</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #5E52AD 0%, #A1AD52 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 3px solid #5E52AD;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 2rem;
            font-weight: bold;
            background: linear-gradient(90deg, #5E52AD, #A1AD52);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .user-info {
            color: #5AA587;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(45deg, #5E52AD, #A1AD52);
            color: white;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
            }

        .btn-download {
            background: linear-gradient(45deg, #28a745, #20c997);
            color: white;
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.4);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-download:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(40, 167, 69, 0.6);
            }

        .content-header {
            background: linear-gradient(135deg, #5E52AD, #A1AD52);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }

            .content-header h1 {
                font-size: 2.5rem;
                margin-bottom: 10px;
            }

            .content-header p {
                font-size: 1.1rem;
                opacity: 0.9;
            }

        .details-section {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            animation: fadeInUp 0.6s ease-out;
        }

        .details-grid {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 20px 40px;
            align-items: center;
        }

        .details-label {
            font-weight: 600;
            color: #5E52AD;
            font-size: 1rem;
        }

        .details-value {
            padding: 15px 20px;
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            border-radius: 10px;
            border-left: 4px solid #5E52AD;
            font-size: 1rem;
        }

            .details-value.highlight {
                background: linear-gradient(135deg, #e3f2fd, #bbdefb);
                border-left-color: #2196f3;
                font-weight: 600;
                font-size: 1.2rem;
            }

        .document-download {
            background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
            border: 2px solid #4caf50;
            border-radius: 12px;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.3s ease;
        }

            .document-download:hover {
                background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(76, 175, 80, 0.3);
            }

        .document-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .document-icon {
            font-size: 1.5rem;
            color: #2e7d32;
        }

        .document-details h4 {
            color: #2e7d32;
            margin-bottom: 4px;
            font-size: 1rem;
        }

        .document-details p {
            color: #388e3c;
            font-size: 0.9rem;
            margin: 0;
        }

        .status-badge {
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 0.95rem;
            font-weight: 600;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-pending {
            background: linear-gradient(135deg, #fff3cd, #ffeaa7);
            color: #856404;
            border: 2px solid #ffc107;
        }

        .status-approved {
            background: linear-gradient(135deg, #d4edda, #a3e9a3);
            color: #155724;
            border: 2px solid #28a745;
        }

        .status-rejected {
            background: linear-gradient(135deg, #f8d7da, #f5c6cb);
            color: #721c24;
            border: 2px solid #dc3545;
        }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .summary-card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            text-align: center;
            transition: all 0.3s ease;
            border-top: 4px solid #5E52AD;
        }

            .summary-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
            }

            .summary-card h4 {
                color: #5E52AD;
                margin-bottom: 10px;
            }

            .summary-card .value {
                font-size: 1.8rem;
                font-weight: bold;
                color: #333;
            }

        .action-section {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .back-link {
            color: #5E52AD;
            text-decoration: none;
            padding: 12px 24px;
            border: 2px solid #5E52AD;
            border-radius: 25px;
            transition: all 0.3s ease;
            font-weight: 600;
        }

            .back-link:hover {
                background: #5E52AD;
                color: white;
            }

        (max-width: 768px) {
            .header-bar

        {
            flex-direction: column;
            gap: 15px;
        }

        .details-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .summary-cards {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

        .document-download {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }

        }

        fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .details-section, .summary-cards, .action-section {
            animation: fadeInUp 0.6s ease-out;
        }

            .summary-cards .summary-card:nth-child(1) {
                animation-delay: 0.1s;
            }

            .summary-cards .summary-card:nth-child(2) {
                animation-delay: 0.2s;
            }

            .summary-cards .summary-card:nth-child(3) {
                animation-delay: 0.3s;
            }
    </style>
</head>
<body>
    <div class="container">
        <header class="header-bar">
            <div class="logo">Contract Management Claim System</div>
            <div class="user-info">@ViewBag.UserFullName</div>
        </header>

        <div class="f-layout">
            <main>
                <div class="content-header">
                    <h1>Claim Details</h1>
                    <p>Review complete information for claim @Model.claimId</p>
                </div>

                <!-- Summary Cards -->
                <div class="summary-cards">
                    <div class="summary-card">
                        <h4>Total Amount</h4>
                        <div class="value">R @Model.totalAmount.ToString("N2")</div>
                    </div>
                    <div class="summary-card">
                        <h4>Hours Worked</h4>
                        <div class="value">@Model.hoursWorked</div>
                    </div>
                    <div class="summary-card">
                        <h4>Hourly Rate</h4>
                        <div class="value">R @Model.hourlyRate.ToString("N2")</div>
                    </div>
                </div>

                <!-- Claim Details Section -->
                <section class="details-section">
                    <h3 style="color: #5E52AD; margin-bottom: 25px; font-size: 1.5rem;">📋 Claim Information</h3>

                    <div class="details-grid">
                        <div class="details-label">Claim ID:</div>
                        <div class="details-value highlight">@Model.claimId</div>

                        <div class="details-label">Lecturer:</div>
                        <div class="details-value">@ViewBag.UserFullName</div>

                        <div class="details-label">Hourly Rate:</div>
                        <div class="details-value">R @Model.hourlyRate.ToString("N2") per hour</div>

                        <div class="details-label">Hours Worked:</div>
                        <div class="details-value">@Model.hoursWorked hours</div>

                        <div class="details-label">Claim Notes:</div>
                        <div class="details-value">@Model.claimNotes</div>

                        <div class="details-label">Current Status:</div>
                        <div class="details-value">
                            @{
                                var statusClass = Model.claimStatus.ToLower() == "pending" ? "status-pending" :
                                Model.claimStatus.ToLower() == "approved" ? "status-approved" :
                                "status-rejected";
                            }
                            <span class="status-badge @statusClass">@Model.claimStatus</span>
                        </div>

                        <div class="details-label">Date Submitted:</div>
                        <div class="details-value">@Model.dateOfClaim.ToString("MMMM dd, yyyy")</div>

                        @if (Model.document != null && Model.document.Length > 0)
                        {
                            <div class="details-label">Supporting Documents:</div>
                            <div class="details-value">
                                <div class="document-download">
                                    <div class="document-info">
                                        <span class="document-icon">📄</span>
                                        <div class="document-details">
                                            <h4>Attached Document</h4>
                                            <p>@Model.documentName</p>
                                        </div>
                                    </div>
                                    <a asp-action="DownloadDocument" asp-route-id="@Model.claimId" class="btn btn-download">
                                        <span>⬇️</span> Download Document
                                    </a>
                                </div>
                            </div>
                        }

                        <div class="details-label">Total Claim Value:</div>
                        <div class="details-value highlight">R @Model.totalAmount.ToString("N2")</div>
                    </div>
                </section>

                <!-- Action Buttons Section -->
                <section class="action-section">
                    <h3 style="color: #5E52AD; margin-bottom: 20px;">Available Actions</h3>
                    <div class="form-actions">
                        <a asp-action="Delete" asp-route-id="@Model.claimId" class="btn btn-primary">Delete</a>
                        <a asp-action="Index" class="back-link">Back to List</a>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <script>
        // Add hover effects to summary cards
        document.querySelectorAll('.summary-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.borderTopColor = '#A1AD52';
            });

            card.addEventListener('mouseleave', function() {
                this.style.borderTopColor = '#5E52AD';
            });
        });
    </script>
</body>
</html>