@{
    ViewData["Title"] = "Login - CMCS";
}

<div class="login-container">
    <div class="login-row">
        <!-- Left Card -->
        <div class="login-left">
            <div class="login-left-content">
                <h1 class="login-title">CMCS</h1>
                <p class="login-subtitle">Contract Management Claim System</p>
                <p class="login-subtitle">Please Enter your Login Details</p>
            </div>
        </div>

        <!-- Right Card - Login form -->
        <div class="login-right">
            <div class="login-card">
                <h2 class="card-title">Login</h2>

                <form asp-action="Login" asp-controller="Account" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <!-- Role Selection Buttons -->
                    <div class="form-group">
                        <label class="form-label">Select Role</label>
                        <div class="role-buttons">
                            <a href="@Url.Action("Index", "Lecturer")" class="role-btn">Lecturer</a>
                            <a href="@Url.Action("Index", "Coordinator")" class="role-btn">Coordinator</a>
                            <a href="@Url.Action("Index", "Manager")" class="role-btn">Manager</a>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="userName" class="form-label">User Name</label>
                        <input type="text" class="form-control" id="userName" name="userName"
                               placeholder="Enter your User Name" required>
                    </div>

                    <div class="form-group">
                        <label for="Password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="Password" name="Password"
                               placeholder="Enter your password" required>
                    </div>

                    <button type="submit" class="btn-signin">Sign In</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background-color: #001B1E;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .login-container {
        width: 100%;
        min-height: 100vh;
        display: flex;
    }

    .login-row {
        display: flex;
        width: 100%;
        min-height: 100vh;
    }

    .login-left {
        flex: 1;
        background: linear-gradient(135deg, #f99f48 50%, #48A2F9 50%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        padding: 40px;
    }

    .login-left-content {
        text-align: center;
    }

    .login-title {
        font-size: 4rem;
        font-weight: bold;
        margin-bottom: 1rem;
    }

    .login-subtitle {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .login-right {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        background-color: #1C2027;
    }

    .login-card {
        background: white;
        border-radius: 15px;
        padding: 50px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    .card-title {
        text-align: center;
        margin-bottom: 2rem;
        font-size: 2rem;
        color: #333;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #333;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        font-size: 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        transition: all 0.3s;
    }

        .form-control:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .role-buttons {
        display: flex;
        gap: 0;
        width: 100%;
    }

    .role-btn {
        flex: 1;
        padding: 10px 16px;
        text-align: center;
        border: 2px solid #f99f48;
        color: #f99f48;
        cursor: pointer;
        transition: all 0.3s;
        font-weight: 500;
        text-decoration: none;
        display: block;
    }

        .role-btn:first-of-type {
            border-radius: 8px 0 0 8px;
        }

        .role-btn:last-of-type {
            border-radius: 0 8px 8px 0;
        }

        .role-btn:hover {
            background: linear-gradient(135deg, #f99f48 0%, #48A2F9 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(249, 159, 72, 0.3);
        }

    .btn-signin {
        width: 100%;
        padding: 14px;
        font-size: 1.1rem;
        font-weight: 500;
        color: white;
        background: linear-gradient(135deg, #f99f48 0%, #48A2F9 100%);
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        margin-top: 1rem;
    }

        .btn-signin:hover {
            background: linear-gradient(135deg, #48A2F9 0%, #f99f48 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

    .text-danger {
        color: #dc3545;
        margin-bottom: 1rem;
    }

    (max-width: 768px) {
        .login-row

    {
        flex-direction: column;
    }

    .login-left {
        display: none;
    }

    .login-card {
        padding: 30px;
    }

    .login-title {
        font-size: 2.5rem;
    }

    .login-subtitle {
        font-size: 1.1rem;
    }

    }
</style>