@model PROG6212_POE.Models.Claim

@{
    ViewData["Title"] = "Generate Invoice";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generate Invoice</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #5DA29A 0%, #A25D65 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1000px;
            margin: 20px auto;
            padding: 20px;
        }

        .no-print {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 20px;
            border-bottom: 3px solid #5DA29A;
        }

        .logo {
            font-size: 2rem;
            font-weight: bold;
            background: linear-gradient(90deg, #5DA29A, #A25D65);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-actions {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(45deg, #5DA29A, #A25D65);
            color: white;
            box-shadow: 0 4px 15px rgba(93, 162, 154, 0.4);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(93, 162, 154, 0.6);
            }

        .btn-secondary {
            background: white;
            color: #5DA29A;
            border: 2px solid #5DA29A;
        }

            .btn-secondary:hover {
                background: #5DA29A;
                color: white;
            }

        .btn-success {
            background: linear-gradient(45deg, #28a745, #20c997);
            color: white;
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.4);
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(40, 167, 69, 0.6);
            }

        .invoice-card {
            background: white;
            padding: 50px;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease-out;
        }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
            padding-bottom: 30px;
            border-bottom: 3px solid #5DA29A;
        }

        .invoice-logo h1 {
            font-size: 2.5rem;
            background: linear-gradient(90deg, #5DA29A, #A25D65);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .invoice-info p {
            margin: 5px 0;
            color: #666;
        }

        .company-details {
            text-align: right;
        }

            .company-details h3 {
                color: #5DA29A;
                margin-bottom: 10px;
            }

            .company-details p {
                margin: 5px 0;
                color: #666;
            }

        .billing-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 40px;
        }

        .billing-box {
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            border-left: 4px solid #5DA29A;
        }

            .billing-box h3 {
                color: #5DA29A;
                margin-bottom: 15px;
            }

            .billing-box p {
                margin: 8px 0;
                color: #333;
            }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
            margin-left: 10px;
        }

        .status-approved {
            background: #d4edda;
            color: #155724;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-rejected {
            background: #f8d7da;
            color: #721c24;
        }

        .details-section {
            margin-bottom: 40px;
        }

            .details-section h3 {
                color: #5DA29A;
                margin-bottom: 20px;
            }

        .details-table {
            width: 100%;
            border-collapse: collapse;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }

            .details-table thead {
                background: linear-gradient(135deg, #5DA29A, #A25D65);
                color: white;
            }

            .details-table th,
            .details-table td {
                padding: 15px;
                text-align: left;
            }

            .details-table tbody tr {
                border-bottom: 1px solid #e9ecef;
            }

                .details-table tbody tr:last-child {
                    border-bottom: none;
                }

        .summary-section {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 40px;
        }

        .summary-box {
            width: 400px;
            background: #f8f9fa;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #dee2e6;
        }

            .summary-row:last-child {
                border-bottom: none;
                border-top: 2px solid #5DA29A;
                margin-top: 10px;
                padding-top: 15px;
            }

            .summary-row.total {
                font-size: 1.3rem;
                font-weight: bold;
            }

                .summary-row.total .amount {
                    background: linear-gradient(90deg, #5DA29A, #A25D65);
                    background-clip: text;
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                }

        .notes-section {
            margin-bottom: 30px;
        }

            .notes-section h4 {
                color: #5DA29A;
                margin-bottom: 10px;
            }

            .notes-section p,
            .notes-section ul {
                color: #666;
                font-size: 0.95rem;
            }

            .notes-section ul {
                margin-left: 20px;
                margin-top: 10px;
            }

            .notes-section li {
                margin: 5px 0;
            }

        .invoice-footer {
            text-align: center;
            padding-top: 30px;
            border-top: 2px solid #e9ecef;
            color: #999;
            font-size: 0.9rem;
        }

        .print-actions {
            text-align: center;
            margin-top: 30px;
        }

        fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        print {
            body

        {
            background: white;
        }

        .no-print {
            display: none !important;
        }

        .container {
            margin: 0;
            padding: 20px;
        }

        .invoice-card {
            box-shadow: none;
            padding: 0;
        }

        }

        (max-width: 768px) {
            .container

        {
            padding: 10px;
        }

        .invoice-card {
            padding: 20px;
        }

        .invoice-header {
            flex-direction: column;
            gap: 20px;
        }

        .company-details {
            text-align: left;
        }

        .billing-section {
            grid-template-columns: 1fr;
        }

        .summary-box {
            width: 100%;
        }

        .details-table {
            font-size: 0.9rem;
        }

            .details-table th,
            .details-table td {
                padding: 10px;
            }

        }
    </style>
</head>
<body>
    <div class="container">
        <div class="no-print">
            <div class="header-bar">
                <div class="logo">Generate Invoice</div>
                <div class="nav-actions">
                    @* <button onclick="window.print()" class="btn btn-primary">
                        🖨️ Print Invoice
                    </button> *@
                    <a href="@Url.Action("Reports", "HR")" class="btn btn-secondary">
                        ← Back to Reports
                    </a>
                </div>
            </div>
        </div>

        <div class="invoice-card">
            <!-- Invoice Header -->
            <div class="invoice-header">
                <div class="invoice-logo">
                    <h1>INVOICE</h1>
                    <div class="invoice-info">
                        <p><strong>Invoice Number:</strong> INV-@Model.claimId.ToString("D6")</p>
                        <p><strong>Invoice Date:</strong> @DateTime.Now.ToString("dd MMMM yyyy")</p>
                        <p><strong>Claim Date:</strong> @Model.dateOfClaim.ToString("dd MMMM yyyy")</p>
                    </div>
                </div>
                <div class="company-details">
                    <h3>Contract Monthly Claim System</h3>
                    <p>123 University Avenue</p>
                    <p>Cape Town, 8001</p>
                    <p>South Africa</p>
                    <p>Tel: +27 21 123 4567</p>
                    <p>Email: finance@cmcs.ac.za</p>
                </div>
            </div>

            <!-- Billing Information -->
            <div class="billing-section">
                <div class="billing-box">
                    <h3>Bill To:</h3>
                    <p><strong>@Model.theUser.Name @Model.theUser.Surname</strong></p>
                    <p>Email: @Model.theUser.Email</p>
                    <p>Role: @Model.theUser.Role</p>
                    @if (Model.theUser.HourlyRate != null)
                    {
                        <p>Standard Rate: R @Model.theUser.HourlyRate.Value.ToString("N2")/hour</p>
                    }
                </div>
                <div class="billing-box">
                    <h3>Claim Status:</h3>
                    <p>
                        <strong>Status:</strong>
                        <span class="status-badge status-@Model.claimStatus.ToLower()">
                            @Model.claimStatus
                        </span>
                    </p>
                    <p>
                        <strong>First Approval:</strong>
                        <span class="status-badge status-@(Model.firstApproval ? "approved" : "pending")">
                            @(Model.firstApproval ? "Approved" : "Pending")
                        </span>
                    </p>
                    @if (!string.IsNullOrEmpty(Model.documentName))
                    {
                        <p><strong>Supporting Document:</strong> Attached</p>
                    }
                </div>
            </div>

            <!-- Claim Details -->
            <div class="details-section">
                <h3>Claim Details</h3>
                <table class="details-table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th style="text-align: center;">Hours Worked</th>
                            <th style="text-align: right;">Rate per Hour</th>
                            <th style="text-align: right;">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong>Lecturer Services</strong><br>
                                <small style="color: #666;">@Model.claimNotes</small>
                            </td>
                            <td style="text-align: center;">@Model.hoursWorked</td>
                            <td style="text-align: right;">R @Model.hourlyRate.ToString("N2")</td>
                            <td style="text-align: right;"><strong>R @Model.totalAmount.ToString("N2")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Payment Summary -->
            <div class="summary-section">
                <div class="summary-box">
                    <div class="summary-row">
                        <span><strong>Subtotal:</strong></span>
                        <span>R @Model.totalAmount.ToString("N2")</span>
                    </div>
                    <div class="summary-row">
                        <span><strong>VAT (0%):</strong></span>
                        <span>R 0.00</span>
                    </div>
                    <div class="summary-row total">
                        <span>Total Amount Due:</span>
                        <span class="amount">R @Model.totalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- Notes -->
            <div class="notes-section">
                <h4>Notes:</h4>
                <p>
                    @if (Model.claimStatus == "Approved")
                    {
                        <text>This invoice has been approved and is ready for payment processing. Payment will be processed according to the standard payment schedule.</text>
                    }
                    else if (Model.claimStatus == "Pending")
                    {
                        <text>This invoice is pending approval. Payment will be processed once the claim is fully approved by the relevant authorities.</text>
                    }
                    else
                    {
                        <text>This invoice has been rejected. Please contact the HR department for more information.</text>
                    }
                </p>
            </div>

            <!-- Terms & Conditions -->
            <div class="notes-section">
                <h4>Terms & Conditions:</h4>
                <ul>
                    <li>Payment is subject to final approval by the Academic Manager</li>
                    <li>All claims must be supported by appropriate documentation</li>
                    <li>Payment will be processed within 30 days of approval</li>
                    <li>All amounts are in South African Rand (ZAR)</li>
                </ul>
            </div>

            <!-- Footer -->
            <div class="invoice-footer">
                <p><strong>Contract Monthly Claim System (CMCS)</strong></p>
                <p>Generated on @DateTime.Now.ToString("dd MMMM yyyy HH:mm")</p>
            </div>
        </div>

        <!-- Print Actions -->
        <div class="no-print print-actions">
            <a href="@Url.Action("DownloadInvoice", "HR", new { id = Model.claimId })"
               class="btn btn-success">
                📥 Download PDF
            </a>
            <a href="@Url.Action("Reports", "HR")" class="btn btn-secondary" style="padding: 15px 30px; font-size: 1.1rem;">
                ← Back to Reports
            </a>
        </div>
    </div>
</body>
</html>