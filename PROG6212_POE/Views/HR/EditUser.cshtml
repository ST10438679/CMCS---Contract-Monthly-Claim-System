@model User

@{
    ViewData["Title"] = "Edit User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #5DA29A 0%, #A25D65 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 900px;
            margin: 20px auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 3px solid #5DA29A;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 2rem;
            font-weight: bold;
            background: linear-gradient(90deg, #5DA29A, #A25D65);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-block;
        }

        .btn-secondary {
            background: white;
            color: #5DA29A;
            border: 2px solid #5DA29A;
        }

            .btn-secondary:hover {
                background: #5DA29A;
                color: white;
            }

        .btn-warning {
            background: linear-gradient(45deg, #ffc107, #ff9800);
            color: white;
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
        }

            .btn-warning:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(255, 193, 7, 0.6);
            }

        .content-header {
            background: linear-gradient(135deg, #ffc107, #ff9800);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(255, 193, 7, 0.3);
        }

            .content-header h1 {
                font-size: 2rem;
                margin-bottom: 5px;
            }

            .content-header p {
                opacity: 0.9;
            }

        .alert {
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            border: 1px solid;
            animation: slideInDown 0.3s ease-out;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border-color: #f5c6cb;
        }

        .form-section {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            animation: fadeInUp 0.6s ease-out;
        }

            .form-section h3 {
                color: #5DA29A;
                margin-bottom: 25px;
                font-size: 1.5rem;
            }

        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: #5DA29A;
            margin-bottom: 8px;
        }

        .required {
            color: #dc3545;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: #5DA29A;
                box-shadow: 0 0 0 3px rgba(93, 162, 154, 0.1);
            }

            .form-control[readonly] {
                background-color: #e9ecef;
                cursor: not-allowed;
            }

        .form-select {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-select:focus {
                outline: none;
                border-color: #5DA29A;
                box-shadow: 0 0 0 3px rgba(93, 162, 154, 0.1);
            }

        .form-text {
            font-size: 0.875rem;
            color: #6c757d;
            margin-top: 5px;
        }

        .text-danger {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 5px;
            display: block;
        }

        .lecturer-fields {
            padding: 20px;
            background: rgba(93, 162, 154, 0.05);
            border-radius: 10px;
            margin-top: 20px;
            border-left: 4px solid #5DA29A;
        }

        .info-alert {
            background: #d1ecf1;
            color: #0c5460;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e9ecef;
        }

        fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        slideInDown {
            from

        {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        (max-width: 768px) {
            .container

        {
            margin: 10px;
            padding: 15px;
        }

        .form-section {
            padding: 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

        .header-bar {
            flex-direction: column;
            gap: 15px;
        }

        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header-bar">
            <div class="logo">Edit User</div>
            <a href="@Url.Action("ManageUsers", "HR")" class="btn btn-secondary">
                ← Back to Users
            </a>
        </header>

        <div class="content-header">
            <h1>Update User Information</h1>
            <p>Modify user account details</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div class="form-section">
                <h3>👤 User Information</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">First Name <span class="required">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter first name" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Surname <span class="required">*</span></label>
                        <input asp-for="Surname" class="form-control" placeholder="Enter surname" required />
                        <span asp-validation-for="Surname" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Email <span class="required">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Leave blank to keep current password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <small class="form-text">Leave blank to keep the current password</small>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Role <span class="required">*</span></label>
                    @if (Model.Role == "HR")
                    {
                        <input asp-for="Role" class="form-control" readonly />
                        <small class="form-text">HR role cannot be changed</small>
                    }
                    else
                    {
                        <select asp-for="Role" class="form-select" id="roleSelect" required>
                            <option value="">-- Select Role --</option>
                            <option value="Lecturer">Lecturer</option>
                            <option value="Programme Coordinator">Programme Coordinator</option>
                            <option value="Academic Manager">Academic Manager</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    }
                </div>

                <div id="lecturerFields" class="lecturer-fields" style="display: @(Model.Role == "Lecturer" ? "block" : "none");">
                    <div class="info-alert">
                        <span>ℹ️</span>
                        <span>Lecturer-specific fields are required</span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Hourly Rate (R) <span class="required">*</span></label>
                            <input asp-for="HourlyRate" type="number" step="0.01" class="form-control" placeholder="Enter hourly rate" />
                            <span asp-validation-for="HourlyRate" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Hour Cap <span class="required">*</span></label>
                            <input asp-for="HourCap" type="number" class="form-control" placeholder="Enter maximum hours" />
                            <span asp-validation-for="HourCap" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("ManageUsers", "HR")" class="btn btn-secondary">
                        ✖ Cancel
                    </a>
                    <button type="submit" class="btn btn-warning">
                        ✓ Update User
                    </button>
                </div>
            </div>
        </form>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        <script>
            const roleSelect = document.getElementById('roleSelect');

            if (roleSelect) {
                roleSelect.addEventListener('change', function() {
                    const lecturerFields = document.getElementById('lecturerFields');
                    const hourlyRateInput = document.querySelector('input[name="HourlyRate"]');
                    const hourCapInput = document.querySelector('input[name="HourCap"]');

                    if (this.value === 'Lecturer') {
                        lecturerFields.style.display = 'block';
                        hourlyRateInput.setAttribute('required', 'required');
                        hourCapInput.setAttribute('required', 'required');
                    } else {
                        lecturerFields.style.display = 'none';
                        hourlyRateInput.removeAttribute('required');
                        hourCapInput.removeAttribute('required');
                    }
                });
            }
        </script>
    }
</body>
</html>