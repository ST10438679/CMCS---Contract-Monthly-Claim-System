@model List<User>

@{
    ViewData["Title"] = "Manage Users";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #5DA29A 0%, #A25D65 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            margin: 20px auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 3px solid #5DA29A;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 2rem;
            font-weight: bold;
            background: linear-gradient(90deg, #5DA29A, #A25D65);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-actions {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(45deg, #5DA29A, #A25D65);
            color: white;
            box-shadow: 0 4px 15px rgba(93, 162, 154, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(93, 162, 154, 0.6);
        }

        .btn-secondary {
            background: white;
            color: #5DA29A;
            border: 2px solid #5DA29A;
        }

        .btn-secondary:hover {
            background: #5DA29A;
            color: white;
        }

        .btn-warning {
            background: linear-gradient(45deg, #ffc107, #ff9800);
            color: white;
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
        }

        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 193, 7, 0.6);
        }

        .btn-danger {
            background: linear-gradient(45deg, #dc3545, #c82333);
            color: white;
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.4);
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(220, 53, 69, 0.6);
        }

        .content-header {
            background: linear-gradient(135deg, #5DA29A, #A25D65);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(93, 162, 154, 0.3);
        }

        .content-header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .alert {
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            border: 1px solid;
            animation: slideInDown 0.3s ease-out;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border-color: #c3e6cb;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border-color: #f5c6cb;
        }

        .users-section {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            animation: fadeInUp 0.6s ease-out;
        }

        .users-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .users-table thead {
            background: linear-gradient(135deg, #5DA29A, #A25D65);
            color: white;
        }

        .users-table th,
        .users-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        .users-table th {
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .users-table tbody tr {
            transition: all 0.3s ease;
        }

        .users-table tbody tr:hover {
            background: rgba(93, 162, 154, 0.05);
            transform: scale(1.01);
        }

        .role-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
        }

        .role-lecturer {
            background: #d4edda;
            color: #155724;
        }

        .role-coordinator {
            background: #d1ecf1;
            color: #0c5460;
        }

        .role-manager {
            background: #fff3cd;
            color: #856404;
        }

        .role-hr {
            background: #d6d8d9;
            color: #383d41;
        }

        .stats-section {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            animation: fadeInUp 0.8s ease-out;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            text-align: center;
        }

        .stat-item h4 {
            font-size: 2rem;
            background: linear-gradient(90deg, #5DA29A, #A25D65);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 5px;
        }

        .stat-item p {
            color: #666;
        }

        fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        slideInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        (max-width: 768px) {
            .container {
                margin: 10px;
                padding: 15px;
            }

            .header-bar {
                flex-direction: column;
                gap: 15px;
            }

            .nav-actions {
                flex-wrap: wrap;
                justify-content: center;
            }

            .users-table {
                font-size: 0.9rem;
            }

            .users-table th,
            .users-table td {
                padding: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header-bar">
            <div class="logo">Manage Users</div>
            <div class="nav-actions">
                <a href="@Url.Action("CreateUser", "HR")" class="btn btn-primary">
                    ➕ Create New User
                </a>
                <a href="@Url.Action("Index", "HR")" class="btn btn-secondary">
                    ← Back to Dashboard
                </a>
            </div>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="content-header">
            <h1>User Management</h1>
            <p>View, create, edit, and manage all user accounts in the system</p>
        </div>

        <section class="users-section">
            <h3 style="color: #5DA29A; margin-bottom: 20px;">All Users</h3>
            <div style="overflow-x: auto;">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Surname</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Hourly Rate</th>
                            <th>Hour Cap</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                var roleClass = user.Role switch
                                {
                                    "Lecturer" => "role-lecturer",
                                    "Programme Coordinator" => "role-coordinator",
                                    "Academic Manager" => "role-manager",
                                    "HR" => "role-hr",
                                    _ => "role-hr"
                                };

                                <tr>
                                    <td>@user.Id</td>
                                    <td>@user.Name</td>
                                    <td>@user.Surname</td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="role-badge @roleClass">@user.Role</span>
                                    </td>
                                    <td>
                                        @if (user.HourlyRate != null)
                                        {
                                            <span>R @user.HourlyRate.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span style="color: #999;">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.HourCap != null)
                                        {
                                            <span>@user.HourCap hrs</span>
                                        }
                                        else
                                        {
                                            <span style="color: #999;">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 10px;">
                                            <a href="@Url.Action("EditUser", "HR", new { id = user.Id })" class="btn btn-warning" style="padding: 6px 12px; font-size: 0.9rem;">
                                                ✏️ Edit
                                            </a>
                                            @if (user.Role != "HR")
                                            {
                                                <a href="@Url.Action("DeleteUser", "HR", new { id = user.Id })" class="btn btn-danger" style="padding: 6px 12px; font-size: 0.9rem;">
                                                    🗑️ Delete
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 40px; color: #666;">
                                    No users found in the system
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="stats-section">
            <h3 style="color: #5DA29A; margin-bottom: 20px;">User Statistics</h3>
            <div class="stats-grid">
                <div class="stat-item">
                    <h4>@Model.Count(u => u.Role == "Lecturer")</h4>
                    <p>Lecturers</p>
                </div>
                <div class="stat-item">
                    <h4>@Model.Count(u => u.Role == "Programme Coordinator")</h4>
                    <p>Coordinators</p>
                </div>
                <div class="stat-item">
                    <h4>@Model.Count(u => u.Role == "Academic Manager")</h4>
                    <p>Managers</p>
                </div>
                @* <div class="stat-item">
                    <h4>@Model.Count(u => u.Role == "HR")</h4>
                    <p>HR Personnel</p>
                </div> *@
            </div>
        </section>
    </div>

    <script>
        // Table row click effect
        document.querySelectorAll('.users-table tbody tr').forEach(row => {
            row.addEventListener('click', function() {
                this.style.background = 'rgba(93, 162, 154, 0.1)';
                setTimeout(() => {
                    this.style.background = '';
                }, 200);
            });
        });
    </script>
</body>
</html>