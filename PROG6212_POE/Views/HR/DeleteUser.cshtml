@model User

@{
    ViewData["Title"] = "Delete User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete User</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #5DA29A 0%, #A25D65 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 3px solid #dc3545;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 2rem;
            font-weight: bold;
            background: linear-gradient(90deg, #dc3545, #c82333);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-block;
        }

        .btn-secondary {
            background: white;
            color: #5DA29A;
            border: 2px solid #5DA29A;
        }

            .btn-secondary:hover {
                background: #5DA29A;
                color: white;
            }

        .btn-danger {
            background: linear-gradient(45deg, #dc3545, #c82333);
            color: white;
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.4);
        }

            .btn-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(220, 53, 69, 0.6);
            }

        .content-header {
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(220, 53, 69, 0.3);
        }

            .content-header h1 {
                font-size: 2rem;
                margin-bottom: 5px;
            }

            .content-header p {
                opacity: 0.9;
            }

        .warning-alert {
            background: linear-gradient(135deg, #fff3cd, #ffeaa7);
            color: #856404;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
            border-left: 5px solid #ffc107;
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
            animation: slideInDown 0.3s ease-out;
        }

            .warning-alert h3 {
                margin-bottom: 10px;
                color: #856404;
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .details-section {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            animation: fadeInUp 0.6s ease-out;
        }

            .details-section h3 {
                color: #dc3545;
                margin-bottom: 25px;
                font-size: 1.5rem;
            }

        .details-table {
            width: 100%;
            border-collapse: collapse;
        }

            .details-table tr {
                border-bottom: 1px solid #e9ecef;
            }

                .details-table tr:last-child {
                    border-bottom: none;
                }

            .details-table th,
            .details-table td {
                padding: 15px;
                text-align: left;
            }

            .details-table th {
                font-weight: 600;
                color: #5DA29A;
                width: 200px;
            }

        .role-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
        }

        .role-lecturer {
            background: #d4edda;
            color: #155724;
        }

        .role-coordinator {
            background: #d1ecf1;
            color: #0c5460;
        }

        .role-manager {
            background: #fff3cd;
            color: #856404;
        }

        .role-hr {
            background: #d6d8d9;
            color: #383d41;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e9ecef;
        }

        fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        slideInDown {
            from

        {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        (max-width: 768px) {
            .container

        {
            margin: 10px;
            padding: 15px;
        }

        .details-section {
            padding: 20px;
        }

        .details-table th,
        .details-table td {
            display: block;
            width: 100%;
        }

        .details-table th {
            padding-bottom: 5px;
        }

        .details-table td {
            padding-top: 5px;
            padding-bottom: 20px;
        }

        .form-actions {
            flex-direction: column;
        }

        .header-bar {
            flex-direction: column;
            gap: 15px;
        }

        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header-bar">
            <div class="logo">Delete User</div>
            <a href="@Url.Action("ManageUsers", "HR")" class="btn btn-secondary">
                ← Back to Users
            </a>
        </header>

        <div class="content-header">
            <h1>⚠️ Confirm User Deletion</h1>
            <p>Are you sure you want to delete this user account?</p>
        </div>

        <div class="warning-alert">
            <h3>
                <span>⚠️</span>
                <span>Warning: This action cannot be undone</span>
            </h3>
            <p>This will permanently remove the user account and all associated data from the system.</p>
        </div>

        <div class="details-section">
            <h3>User Details</h3>
            <table class="details-table">
                <tr>
                    <th>User ID:</th>
                    <td>@Model.Id</td>
                </tr>
                <tr>
                    <th>Name:</th>
                    <td>@Model.Name @Model.Surname</td>
                </tr>
                <tr>
                    <th>Email:</th>
                    <td>@Model.Email</td>
                </tr>
                <tr>
                    <th>Role:</th>
                    <td>
                        @{
                            var roleClass = Model.Role switch
                            {
                                "Lecturer" => "role-lecturer",
                                "Programme Coordinator" => "role-coordinator",
                                "Academic Manager" => "role-manager",
                                "HR" => "role-hr",
                                _ => "role-hr"
                            };
                        }
                        <span class="role-badge @roleClass">@Model.Role</span>
                    </td>
                </tr>
                @if (Model.HourlyRate != null)
                {
                    <tr>
                        <th>Hourly Rate:</th>
                        <td>R @Model.HourlyRate.Value.ToString("N2")</td>
                    </tr>
                }
                @if (Model.HourCap != null)
                {
                    <tr>
                        <th>Hour Cap:</th>
                        <td>@Model.HourCap hours</td>
                    </tr>
                }
            </table>

            <form asp-action="DeleteUserConfirmed" method="post" onsubmit="return confirmDelete()">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="form-actions">
                    <a href="@Url.Action("ManageUsers", "HR")" class="btn btn-secondary">
                        ✖ Cancel
                    </a>
                    <button type="submit" class="btn btn-danger">
                        🗑️ Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function confirmDelete() {
            return confirm(
                'FINAL CONFIRMATION:\n\n' +
                'Are you absolutely sure you want to delete @Model.Name @Model.Surname?\n\n' +
                '• User account will be permanently removed\n' +
                '• All associated data will be deleted\n' +
                '• This action CANNOT be undone\n\n' +
                'Click OK to confirm deletion.'
            );
        }
    </script>
</body>
</html>