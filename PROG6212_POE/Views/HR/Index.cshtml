@{
    ViewData["Title"] = "HR Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HR Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #5DA29A 0%, #A25D65 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            margin: 20px auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 3px solid #5DA29A;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 2rem;
            font-weight: bold;
            background: linear-gradient(90deg, #5DA29A, #A25D65);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logout-btn {
            padding: 10px 20px;
            background: linear-gradient(45deg, #dc3545, #c82333);
            color: white;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.4);
        }

        .content-header {
            background: linear-gradient(135deg, #5DA29A, #A25D65);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(93, 162, 154, 0.3);
        }

        .content-header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .content-header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        .dashboard-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            border-left: 5px solid #5DA29A;
            text-align: center;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        .card-icon {
            font-size: 3rem;
            margin-bottom: 15px;
            color: #5DA29A;
        }

        .card h3 {
            color: #5DA29A;
            margin-bottom: 15px;
            font-size: 1.4rem;
        }

        .card p {
            color: #666;
            margin-bottom: 20px;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(45deg, #5DA29A, #A25D65);
            color: white;
            box-shadow: 0 4px 15px rgba(93, 162, 154, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(93, 162, 154, 0.6);
        }

        .btn-success {
            background: linear-gradient(45deg, #28a745, #20c997);
            color: white;
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.4);
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.6);
        }

        .quick-actions {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            animation: fadeInUp 0.6s ease-out;
        }

        .quick-actions h3 {
            color: #5DA29A;
            margin-bottom: 20px;
            font-size: 1.4rem;
        }

        .action-list {
            list-style: none;
        }

        .action-list li {
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 10px;
            transition: all 0.3s ease;
            background: rgba(93, 162, 154, 0.05);
        }

        .action-list li:hover {
            background: linear-gradient(135deg, #5DA29A, #A25D65);
            transform: translateX(5px);
        }

        .action-list a {
            color: #5DA29A;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .action-list li:hover a {
            color: white;
        }

        fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        (max-width: 768px) {
            .container {
                margin: 10px;
                padding: 15px;
            }

            .dashboard-cards {
                grid-template-columns: 1fr;
            }

            .header-bar {
                flex-direction: column;
                gap: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header-bar">
            <div class="logo">HR Dashboard</div>
            <div>
                <span style="margin-right: 15px; color: #5DA29A; font-weight: 600;">Welcome, @ViewBag.UserName</span>
                <a asp-controller="Account" asp-action="Logout" class="logout-btn">Logout</a>
            </div>
        </header>

        <div class="content-header">
            <h1>HR Management Portal</h1>
            <p>Manage users, view reports, and oversee system operations</p>
        </div>

        <div class="dashboard-cards">
            <div class="card">
                <div class="card-icon">👥</div>
                <h3>Manage Users</h3>
                <p>Create, edit, and manage user accounts across all roles</p>
                <a href="@Url.Action("ManageUsers", "HR")" class="btn btn-primary">
                    Manage Users
                </a>
            </div>

            <div class="card">
                <div class="card-icon">📊</div>
                <h3>View Reports</h3>
                <p>Generate and view detailed reports on all claims</p>
                <a href="@Url.Action("Reports", "HR")" class="btn btn-success">
                    View Reports
                </a>
            </div>
        </div>

        <div class="quick-actions">
            <h3>Quick Actions</h3>
            <ul class="action-list">
                <li>
                    <a href="@Url.Action("CreateUser", "HR")">
                        <span>➕</span> Create New User
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("ManageUsers", "HR")">
                        <span>✏️</span> Edit User Details
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Reports", "HR")">
                        <span>🧾</span> Generate Invoice
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <script>
        document.querySelectorAll('.card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.borderLeftColor = '#A25D65';
            });

            card.addEventListener('mouseleave', function() {
                this.style.borderLeftColor = '#5DA29A';
            });
        });
    </script>
</body>
</html>